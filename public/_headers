# Applied by Netlify to every deploy, however it is uploaded.
# Keeps the site out of search engines and link previews.
/*
  X-Robots-Tag: noindex, nofollow, noarchive, noimageindex
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# Fingerprinted assets never change, so browsers may keep them.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The music file. A week, so a replacement track is picked up in good time.
/audio/*
  Cache-Control: public, max-age=604800
