---
/** Ornamental divider, in the manner of the rules around the date on the invitation. */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg class:list={['rule', className]} viewBox="0 0 320 20" fill="none" aria-hidden="true" focusable="false">
  <g stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
    <path d="M22 10H138" />
    <path d="M182 10H298" />
    <path d="M12 10l5-4 5 4-5 4z" />
    <path d="M308 10l-5-4-5 4 5 4z" />
    <path d="M160 2c1.5 5 3 6.5 8 8-5 1.5-6.5 3-8 8-1.5-5-3-6.5-8-8 5-1.5 6.5-3 8-8z" fill="currentColor" stroke="none" />
    <path d="M146 10c3-3 5-3 7 0-2 3-4 3-7 0z" />
    <path d="M174 10c-3-3-5-3-7 0 2 3 4 3 7 0z" />
  </g>
</svg>
