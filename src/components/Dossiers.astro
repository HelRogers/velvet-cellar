---
/**
 * The individual dossiers. One per guest in src/content/guests.json, each opened
 * from the register as a full-screen file (address: #dossier-<slug>, so the
 * browser's back button returns to the register).
 *
 * Each file has three separate parts:
 *   1. The public sheet: identity and the Public Story, in the character's own words.
 *   2. The Private Backstory, redacted until the guest confirms the file is theirs.
 *      The text is not written into the page as readable text (see src/lib/seal.ts),
 *      so it cannot be found by searching, selecting the bars or a screen reader
 *      before the reveal. This is a courtesy barrier agreed with the host, not security.
 *   3. The full character booklet, which stays sealed until the host releases it.
 */
import data from '../content/guests.json';
import Display from './Display.astro';
import { seal } from '../lib/seal';

const guests = data.guests;
const fileNumber = (i: number) => `VC-1925-${String(i + 1).padStart(3, '0')}`;
const portraits = import.meta.glob<{ default: ImageMetadata }>('../assets/portraits/*.{jpg,jpeg,png,webp}', { eager: true });
const portraitFor = (file: string) => (file ? portraits[`../assets/portraits/${file}`]?.default : undefined);
// Stage directions in a Public Story, such as [blow a kiss to the crowd], are set apart from the speech.
const storyParts = (story: string) =>
  story
    .split(/(\[[^\]]+\])/)
    .filter(Boolean)
    .map((part) => ({ text: part, direction: part.startsWith('[') }));
// What the redacted section holds: the backstory, and the original role where the public one was shortened.
const sealedFor = (guest: (typeof guests)[number]) =>
  seal(
    JSON.stringify({ role: guest.occupation !== guest.publicRole ? guest.occupation : '', text: guest.privateBackstory }),
    guest.slug,
  );
// A fingerprint: nested, slightly irregular loops.
const whorls = Array.from({ length: 9 }, (_, i) => {
  const r = 8 + i * 6.5;
  return `M${60 - r} ${78 + i * 1.5}C${60 - r} ${70 - r * 1.15} ${60 + r} ${70 - r * 1.15} ${60 + r} ${78 + i * 1.5}${i > 2 ? `v${10 + i * 3}` : ''}`;
});
---

{
  guests.map((guest, i) => {
    const portrait = portraitFor(guest.portrait);
    return (
      <article class="dossier" id={`dossier-${guest.slug}`} data-dossier aria-labelledby={`dossier-title-${guest.slug}`} hidden>
        <div class="dossier-bar">
          <a class="btn btn--quiet dossier-back" href="#archives" data-dossier-back>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M19 12H5M11 6l-6 6 6 6" />
            </svg>
            Return to the register
          </a>
          <span class="typed dossier-ref"><span class="dossier-ref-prefix">File No. </span>{fileNumber(i)}</span>
        </div>

        <div class="dossier-folder">
          <div class="dossier-sheet">
            <span class="stamp stamp--large typed" aria-hidden="true">Confidential</span>

            <div class="dossier-top">
              <figure class="dossier-portrait">
                <svg class="paperclip" viewBox="0 0 40 96" fill="none" aria-hidden="true" focusable="false">
                  <path d="M13 70V22a9 9 0 0 1 18 0v52a14 14 0 0 1-28 0V26" stroke="#8d8a82" stroke-width="3" stroke-linecap="round" />
                  <path d="M13 70V22a9 9 0 0 1 18 0v52a14 14 0 0 1-28 0V26" stroke="#e9e6dc" stroke-width="1" stroke-linecap="round" transform="translate(-0.8 -0.8)" />
                </svg>
                {portrait ? (
                  <img src={portrait.src} width={portrait.width} height={portrait.height} alt={`Portrait of ${guest.character}`} loading="lazy" decoding="async" />
                ) : (
                  <div class="portrait-blank">
                    <span class="typed">Portrait to be supplied</span>
                  </div>
                )}
              </figure>

              <div class="dossier-identity">
                <p class="typed dossier-label">Subject</p>
                <Display as="h2" id={`dossier-title-${guest.slug}`} class="dossier-name" text={guest.character} />
                <dl class="dossier-facts">
                  <div>
                    <dt class="typed">Guest</dt>
                    <dd>{guest.guest}</dd>
                  </div>
                  <div>
                    <dt class="typed">Occupation</dt>
                    <dd>{guest.publicRole ? guest.publicRole : <span class="typed withheld">Withheld</span>}</dd>
                  </div>
                  <div>
                    <dt class="typed">Establishment</dt>
                    <dd>The Velvet Cellar, 1925</dd>
                  </div>
                  <div>
                    <dt class="typed">Status</dt>
                    <dd>{guest.booklet === 'released' ? 'Dossier available' : 'Identity revealed'}</dd>
                  </div>
                </dl>
              </div>
            </div>

            <section class="dossier-story" aria-labelledby={`story-title-${guest.slug}`}>
              <h3 class="typed dossier-label" id={`story-title-${guest.slug}`}>Public Story</h3>
              <p class="story-note">What is publicly known, in the subject’s own words.</p>
              {guest.publicStory ? (
                <blockquote class="public-story">
                  <p>
                    “{storyParts(guest.publicStory).map((part) => (part.direction ? <span class="direction">{part.text}</span> : part.text))}”
                  </p>
                </blockquote>
              ) : (
                <p class="placeholder-text typed">[ The host’s approved Public Story for this character will appear here. None has been supplied yet. ]</p>
              )}
            </section>

            <svg class="fingerprint" viewBox="0 0 120 150" fill="none" aria-hidden="true" focusable="false">
              <g stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                {whorls.map((d) => <path d={d} />)}
              </g>
            </svg>
          </div>

          {guest.privateBackstory && (
            <section
              class="dossier-private"
              aria-labelledby={`private-title-${guest.slug}`}
              data-private
              data-state="redacted"
              data-key={guest.slug}
              data-sealed={sealedFor(guest)}
            >
              <span class="stamp stamp--large stamp--secret typed" aria-hidden="true">Top Secret</span>
              <div class="private-head" tabindex="-1" data-private-focus>
                <p class="typed dossier-label">Classified. Recipient: {guest.guest}</p>
                <Display as="h3" id={`private-title-${guest.slug}`} class="private-title" text="Private Backstory" />
              </div>
              <p class="sr-only" data-private-note>
                This part of the file is redacted. Confirm below that the dossier is yours to reveal it.
              </p>

              <div class="private-body" data-private-body aria-hidden="true" />
              <noscript>
                <p class="placeholder-text typed">[ Revealing a private backstory needs JavaScript to be switched on in your browser. ]</p>
              </noscript>

              <form class="private-gate" data-private-gate novalidate>
                <p class="typed gate-title">For your eyes only</p>
                <p>
                  The information concealed within this dossier is strictly confidential. Reading another guest’s private
                  backstory could compromise the investigation and spoil the mystery for everyone.
                </p>
                <p>Please only proceed if this is your assigned character.</p>
                <label class="gate-check">
                  <input type="checkbox" name="recipient" data-private-confirm aria-describedby={`gate-error-${guest.slug}`} />
                  <span>I confirm that I am the intended recipient of this dossier.</span>
                </label>
                <p class="gate-error" id={`gate-error-${guest.slug}`} role="alert" data-private-error hidden>
                  Tick the box to confirm this dossier is yours before unredacting it.
                </p>
                <button class="btn btn--ink" type="submit">Unredact confidential information</button>
              </form>

              <div class="private-after" data-private-after hidden>
                <p>This dossier is open. Reseal it once you have finished reading.</p>
                <button class="btn btn--paper" type="button" data-private-reseal>Reseal this dossier</button>
              </div>
              <p class="sr-only" role="status" aria-live="polite" data-private-status />
            </section>
          )}

          <section class="dossier-sealed" aria-labelledby={`sealed-title-${guest.slug}`}>
            <svg class="sealed-wax" viewBox="0 0 200 200" aria-hidden="true" focusable="false"><use href="#vc-seal"></use></svg>
            <div>
              <p class="typed sealed-label">Character booklet</p>
              <Display as="h3" id={`sealed-title-${guest.slug}`} class="sealed-title" text="Further Correspondence Sealed" />
              <p>Your identity has been revealed. However, certain matters remain confidential.</p>
              <p>
                Your full character booklet, with further confidential instructions for the evening, will be released here
                before The Velvet Cellar opens its doors.
              </p>
              <p class="redactions" aria-hidden="true">
                <span style="width:78%" /><span style="width:92%" /><span style="width:54%" />
              </p>
            </div>
          </section>
        </div>
      </article>
    );
  })
}
