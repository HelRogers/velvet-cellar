---
/**
 * The burgundy wax seal with its VC monogram, defined once as an SVG symbol.
 * The envelope draws it twice (the part on the flap and the part on the body)
 * so that the seal can break along the flap's edge.
 */
const radii = [5, -3, 7, 1, -4, 6, 10, -2, 4, -5, 7, 2, -3, 6, -1, 4];
const n = radii.length;
const pts = radii.map((d, i) => {
  const a = (i / n) * Math.PI * 2 - Math.PI / 2;
  const r = 86 + d;
  return [100 + r * Math.cos(a), 100 + r * Math.sin(a)];
});
// Closed Catmull-Rom spline converted to cubic Béziers.
const f = (v: number) => v.toFixed(1);
let outline = `M${f(pts[0][0])} ${f(pts[0][1])}`;
for (let i = 0; i < n; i++) {
  const p0 = pts[(i - 1 + n) % n];
  const p1 = pts[i];
  const p2 = pts[(i + 1) % n];
  const p3 = pts[(i + 2) % n];
  const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
  const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
  outline += `C${f(c1[0])} ${f(c1[1])} ${f(c2[0])} ${f(c2[1])} ${f(p2[0])} ${f(p2[1])}`;
}
outline += 'Z';
---

<svg class="sr-only" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="vc-wax" cx="36%" cy="30%" r="78%">
      <stop offset="0" stop-color="#a02a40"></stop>
      <stop offset="0.45" stop-color="#74142a"></stop>
      <stop offset="1" stop-color="#3d0612"></stop>
    </radialGradient>
    <radialGradient id="vc-wax-well" cx="42%" cy="36%" r="70%">
      <stop offset="0" stop-color="#6c1226"></stop>
      <stop offset="1" stop-color="#4a0817"></stop>
    </radialGradient>
    <filter id="vc-wax-soft" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="5"></feGaussianBlur>
    </filter>
    <symbol id="vc-seal" viewBox="0 0 200 200">
      <!-- the seal's own shadow on the paper -->
      <ellipse cx="104" cy="112" rx="80" ry="78" fill="#1d0f02" fill-opacity="0.55" filter="url(#vc-wax-soft)"></ellipse>
      <g transform="translate(100 100) scale(0.86) translate(-100 -100)">
      <path d={outline} fill="url(#vc-wax)"></path>
      <path d={outline} fill="none" stroke="#2a020a" stroke-opacity="0.55" stroke-width="2.5"></path>
      <path d={outline} fill="none" stroke="#d98a98" stroke-opacity="0.22" stroke-width="1.5" transform="translate(-1.5 -2)"></path>
      <!-- the pressed well -->
      <circle cx="100" cy="100" r="63" fill="url(#vc-wax-well)"></circle>
      <circle cx="100" cy="100" r="63" fill="none" stroke="#24020a" stroke-opacity="0.75" stroke-width="2.5"></circle>
      <circle cx="101.5" cy="102" r="63" fill="none" stroke="#c96b7d" stroke-opacity="0.38" stroke-width="1.5"></circle>
      <circle cx="100" cy="100" r="55" fill="none" stroke="#8d2238" stroke-width="2.6" stroke-linecap="round" stroke-dasharray="0.1 7.1"></circle>
      <circle cx="100" cy="100" r="48" fill="none" stroke="#2a020a" stroke-opacity="0.45" stroke-width="1"></circle>
      <!-- monogram, embossed: shade above-left, light below-right, then the face -->
      <g font-family="'Elsie Swash Caps', 'Smythe', Georgia, serif" font-size="66" text-anchor="middle">
        <g fill="#24020a" fill-opacity="0.8" transform="translate(-1.2 -1.5)">
          <text x="84" y="121">V</text>
          <text x="121" y="124">C</text>
        </g>
        <g fill="#d27f90" fill-opacity="0.55" transform="translate(1.2 1.6)">
          <text x="84" y="121">V</text>
          <text x="121" y="124">C</text>
        </g>
        <g fill="#851b30">
          <text x="84" y="121">V</text>
          <text x="121" y="124">C</text>
        </g>
      </g>
      <!-- soft light on the wax -->
      <ellipse cx="62" cy="50" rx="36" ry="15" transform="rotate(-32 62 50)" fill="#fff" fill-opacity="0.2" filter="url(#vc-wax-soft)"></ellipse>
      <ellipse cx="52" cy="44" rx="9" ry="3.5" transform="rotate(-32 52 44)" fill="#fff" fill-opacity="0.28"></ellipse>
      </g>
    </symbol>
  </defs>
</svg>
